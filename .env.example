# Local development with docker-compose.local.yml.
DOCKER_PLATFORM=linux/amd64
MYSQL_DATABASE=sports_management
MYSQL_USER=sports_management_user
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3308
DATABASE_URL=mysql+pymysql://sports_management_user:replace-with-a-local-database-password@db:3306/sports_management
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Production: do not include docker-compose.local.yml. Point DATABASE_URL at
# the externally managed MySQL instance instead.
