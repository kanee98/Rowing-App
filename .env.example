# Local development with docker-compose.local.yml (Microsoft SQL Server 2022)
DOCKER_PLATFORM=linux/amd64
MSSQL_SA_PASSWORD=RowingApp2026!
MSSQL_PORT=1433
DATABASE_URL=mssql+pymssql://sa:RowingApp2026!@db:1433/sports_management
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# If connecting to an external SQL Server on your Windows host:
# DATABASE_URL=mssql+pymssql://sa:password@host.docker.internal:1433/sports_management

