ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-this-for-production-rowing-app-2026
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://rowing.jet7ads.lk
PUBLIC_APP_URL=https://rowing.jet7ads.lk

# Database options:
# 1. Cloud Production (Aiven.io MySQL):
DATABASE_URL=mysql+pymysql://avnadmin:your-password@your-aiven-host.aivencloud.com:port/defaultdb?ssl-mode=REQUIRED

# 2. Local Development (MSSQL with Windows Auth):
# DATABASE_URL=mssql+pyodbc://localhost/sports_management?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# 3. Local Development (MSSQL with SQL Server Auth):
# DATABASE_URL=mssql+pymssql://sa:YourPassword@localhost:1433/sports_management

# SMTP Email Configuration:
SMTP_HOST=mail.jet7ads.lk
SMTP_PORT=587
SMTP_FROM=noreply@jet7ads.lk
SMTP_USERNAME=noreply@jet7ads.lk
SMTP_PASSWORD=your-smtp-password
SMTP_STARTTLS=True
SMTP_SSL=False
EMAIL_WORKER_ENABLED=True
REMINDER_HOURS=24
