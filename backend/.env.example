ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-this-for-production-rowing-app-2026
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Option A: MSSQL with SQL Server Authentication (pymssql - works locally and on Vercel)
DATABASE_URL=mssql+pymssql://sa:YourPassword@localhost:1433/sports_management

# Option B: MSSQL with Windows Authentication (pyodbc on Windows)
# DATABASE_URL=mssql+pyodbc://localhost/sports_management?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# Or for named instance like SQLEXPRESS:
# DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/sports_management?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

